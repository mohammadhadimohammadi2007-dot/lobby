<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests log to the console only, so test runs never write or archive logs/latest.log. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss} %-5level] %msg%n%ex{short}</pattern>
        </encoder>
    </appender>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.mariadb.jdbc" level="WARN"/>
    <logger name="org.jline" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
